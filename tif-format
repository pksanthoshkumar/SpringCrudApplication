@RestController
@RequestMapping("/api/tiff")
public class TiffController {

    @PostMapping("/create-from-bytes")
    public ResponseEntity<String> createMultiPartTiff(@RequestBody List<byte[]> imageBytesList) {
        try {
            byte[] multiPartTiff = MultiPartTiffFromBytes.createMultiPartTiff(imageBytesList);

            // Save to disk or return as a response
            Files.write(Paths.get("multi-part.tiff"), multiPartTiff);
            return ResponseEntity.ok("Multi-part TIFF created successfully.");
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                                 .body("Failed to create TIFF: " + e.getMessage());
        }
    }
}
