@Service
public class MyService {

    private final WebClient webClient;

    @Autowired
    public MyService(WebClient webClient) {
        this.webClient = webClient;
    }

    public String fetchData() {
        return webClient.get()
                .uri("/some-endpoint")
                .retrieve()
                .bodyToMono(String.class)
                .block(); // Blocking call for demonstration; consider using reactive streams in production.
    }
}
----------------------------------
@Service
public class MyService {

    private final WebClient webClient;

    @Autowired
    public MyService(WebClient webClient) {
        this.webClient = webClient;
    }

    public Mono<String> postJsonPayload(String jsonPayload) {
        return webClient.post()
                .uri("/some-endpoint") // Relative to baseUrl or full URL
                .header(HttpHeaders.CONTENT_TYPE, MediaType.APPLICATION_JSON_VALUE) // Specify JSON content type
                .bodyValue(jsonPayload) // Set the JSON string as the body
                .retrieve() // Trigger the HTTP call
                .bodyToMono(String.class); // Map the response to a String
    }
}
-----------------------------------------
public void callService() {
    String jsonPayload = "{\"name\": \"John Doe\", \"age\": 30}";

    postJsonPayload(jsonPayload).subscribe(response -> {
        System.out.println("Response: " + response);
    });
}
